external-controller: 127.0.0.1:9093
find-process-mode: strict
ipv6: true
tcp-concurrent: true
unified-delay: true

allow-lan: true
bind-address: "*"

profile:
  store-fake-ip: true
  store-selected: true

geo-auto-update: true
geo-update-interval: 24

geox-url:
  asn: "https://cdn.jsdelivr.net/gh/P3TERX/GeoLite.mmdb@download/GeoLite2-ASN.mmdb"
  mmdb: "https://cdn.jsdelivr.net/gh/P3TERX/GeoLite.mmdb@download/GeoLite2-Country.mmdb"
  geoip: "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.dat"
  geosite: "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat"

proxy-providers:
  sub:
    type: http
    interval: 86400
    url: PUT_YOUR_SUB_URL_HERE
    health-check:
      enable: true
      interval: 60
      url: http://cp.cloudflare.com/generate_204

tun:
  enable: true
  auto-route: true
  auto-detect-interface: true
  endpoint-independent-nat: true
  stack: mixed
  strict-route: true

  dns-hijack:
    - any:53
    - tcp://any:53

dns:
  enable: true
  enhanced-mode: fake-ip
  ipv6: true
  respect-rules: true

  fake-ip-range: 28.0.0.1/16
  fake-ip-range6: 3000:cafe::/64

  default-nameserver:
    - 1.1.1.1
    - 119.29.29.29

  nameserver:
    - https://dns.google/dns-query
    - https://dns.cloudflare.com/dns-query

  direct-nameserver:
    - https://doh.pub/dns-query
    - https://dns.cloudflare.com/dns-query

  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.cloudflare.com/dns-query

  fake-ip-filter:
    - "*"
    - geosite:private

  nameserver-policy:
    geosite:private: system

